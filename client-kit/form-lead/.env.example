# form-lead env vars. Placeholders only: set the real values in the client's Vercel project
# (Settings > Environment Variables). Never commit a real token.

# Sub-account Private Integration token (scopes: contacts.write, contacts.readonly,
# opportunities.write, opportunities.readonly). Revoke it at offboarding.
GHL_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The client's GHL sub-account (location) ID.
GHL_LOCATION_ID=your_location_id

# Custom field IDs in this sub-account (they differ per client).
GHL_FIELD_LEAD_SOURCE=your_lead_source_field_id
GHL_FIELD_SERVICE=your_service_needed_field_id

# Pipeline and stage new opportunities go into.
GHL_PIPELINE_ID=your_pipeline_id
GHL_STAGE_ID=your_new_lead_stage_id

# Comma-separated site origins allowed to post (scheme + host, no path).
ALLOWED_ORIGINS=https://www.example-client.com,https://example-client.com
